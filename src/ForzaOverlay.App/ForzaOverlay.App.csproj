<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ForzaOverlay.App</RootNamespace>
    <AssemblyName>ForzaFatFishHUD</AssemblyName>
    <Product>Forza Fat Fish HUD</Product>
    <AssemblyTitle>Forza Fat Fish HUD</AssemblyTitle>
    <Version>1.2.2</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\Images\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NHotkey.Wpf" Version="4.0.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Fonts\D-DIN-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- 极简弧环（环表）专用：档位/车速大字用 Orbitron，小字标签用 Rajdhani。两者都是 OFL 1.1。 -->
    <None Update="Assets\Fonts\Orbitron-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\Rajdhani-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Images\app.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Images\whale-maid.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Images\whale-maid-full.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Sounds\AE86windchime.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForzaOverlay.Core\ForzaOverlay.Core.csproj" />
  </ItemGroup>

  <!--
    只给 tools\snapshot 这个离屏快照工具开放 internal 成员
    （AltezzaScene / Nfs19Scene 都是 internal）。
    这样做是为了在不扩大主程序公开 API 的前提下，让工具能调用真实绘制代码，
    而不是复制一份 —— 复制出来的和真实绘制会不同步，快照就失去意义。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="snapshot" />
  </ItemGroup>

</Project>
