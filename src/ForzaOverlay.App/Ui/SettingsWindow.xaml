                                               VerticalAlignment="Center"
                                               Margin="0,0,16,0"
                                               Opacity="0" />
                                    <ComboBox x:Name="AspectCombo"
                                              Style="{StaticResource SelectStyle}"
                                              Width="170"
                                              Focusable="False"
                                              SelectionChanged="AspectCombo_SelectionChanged" />
                                </StackPanel>
                            </Grid>
                            <Grid Height="1" Background="{StaticResource HairlineBrush}" />

                            <Grid MinHeight="92">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,22,40,22">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="基础面板背景" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="经典仪表、轮胎与悬挂、HUD 渲染资源占用的背景透明度，0 为完全透明，内容不受影响" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,28,0,0">
                                    <Slider x:Name="PanelOpacitySlider"
                                            Width="200"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="10"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="PanelOpacitySlider_ValueChanged" />
                                    <TextBlock x:Name="PanelOpacityText"
                                               Text="30%"
                                               Width="52"
                                               FontSize="13"
                                               Foreground="{StaticResource DimBrush}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Height="1" Background="{StaticResource HairlineBrush}" />

                            <Grid x:Name="CustomSizePanel" MinHeight="84" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,22,40,22">
                                    <TextBlock Style="{StaticResource RowTitleStyle}" Text="自定义尺寸" />
                                    <TextBlock Style="{StaticResource RowDescStyle}" Text="填写宽高像素值，布局编辑器按该比例绘制画布" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,24,0,0">
                                    <Grid Width="90">
                                        <TextBox x:Name="CustomWidthBox"
                                                 Style="{StaticResource FieldStyle}"
                                                 TextAlignment="Center"
                                                 Padding="8,0,24,0"
                                                 PreviewTextInput="PortBox_PreviewTextInput"
                                                 TextChanged="CustomSizeBox_TextChanged" />
                                        <TextBlock Text="px" FontSize="12" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource MetaBrush}" />
                                    <Grid Width="90">
                                        <TextBox x:Name="CustomHeightBox"
                                                 Style="{StaticResource FieldStyle}"
                                                 TextAlignment="Center"
                                                 Padding="8,0,24,0"
                                                 PreviewTextInput="PortBox_PreviewTextInput"
                                                 TextChanged="CustomSizeBox_TextChanged" />
                                        <TextBlock Text="px" FontSize="12" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />
                                    </Grid>
                                    <TextBlock x:Name="DerivedRatioText"
                                               Text="= 16:9"
                                               FontSize="13"
                                               Foreground="{StaticResource MetaBrush}"
                                               VerticalAlignment="Center"
                                               Margin="16,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Height="1" Background="{StaticResource HairlineBrush}" />

                            <Button x:Name="OpenLayoutButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="打开布局编辑器"
                                    HorizontalAlignment="Left"
                                    Margin="0,22,0,0"
                                    Click="OpenLayoutButton_Click" />
                            <TextBlock Style="{StaticResource NoteStyle}"
                                       Text="在编辑器中拖动模块调整位置，拖右下角方块调整大小；按 Enter 保存，按 Esc 取消。" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageLog" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="运行日志" />
                            <TextBlock Style="{StaticResource SubtitleStyle}" Text="本次运行的诊断记录；每次启动生成一个新文件，logs 目录自动保留最近 7 天" />

                            <TextBox x:Name="LogBox"
                                     Style="{StaticResource LogBoxStyle}"
                                     Height="340"
                                     Margin="0,20,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="刷新"
                                        Margin="0,0,12,0"
                                        Click="RefreshLogButton_Click" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="打开日志目录"
                                        Click="OpenLogFolderButton_Click" />
                            </StackPanel>

                            <Grid Height="1" Background="{StaticResource HairlineBrush}" Margin="0,18,0,0" />

                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource RowTitleStyle}" Text="性能记录（卡顿诊断）" />
                                <TextBlock Style="{StaticResource RowDescStyle}"
                                           Text="每秒记录 HUD 帧耗时、GC、CPU/GPU、遥测包间隔，并保留卡顿前后逐帧明细；写入 logs\perf，保留最近 7 天。排查卡顿时开启，平时保持关闭。" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="记录性能日志"
                                           FontSize="13"
                                           Foreground="{StaticResource MetaBrush}"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="PerfLogSwitch"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              VerticalAlignment="Center"
                                              Margin="12,0,0,0"
                                              Checked="PerfLogSwitch_Changed"
                                              Unchecked="PerfLogSwitch_Changed" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="打开 perf 目录"
                                        Margin="0,0,12,0"
                                        Click="OpenPerfFolderButton_Click" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="标记此刻"
                                        Margin="0,0,16,0"
                                        Click="MarkPerfButton_Click" />
                                <TextBlock x:Name="PerfLogStatusText"
                                           FontSize="12"
                                           Foreground="{StaticResource MetaBrush}"
                                           VerticalAlignment="Center"
                                           Text="未开启" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageAbout" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="关于" />
                            <TextBlock Style="{StaticResource SubtitleStyle}" Text="Forza Fat Fish HUD · 开源免费的极限竞速遥测 HUD" />

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="开源与授权" />
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource RowDescStyle}"
                                           Text="本软件完全开源、免费：无付费功能、无广告、无账号、无数据上传。所有遥测数据仅在本机处理。" />
                                <TextBlock Style="{StaticResource RowDescStyle}" Text="许可证：MIT License" />
                                <TextBlock Style="{StaticResource RowDescStyle}"
                                           Text="第三方组件声明见发布包内的 THIRD-PARTY-NOTICES.txt。" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="开发说明" Margin="0,28,0,0" />
                            <TextBlock Style="{StaticResource RowDescStyle}"
                                       Text="本项目由 DeepSeek Harness 全程参与开发（峰谷 token 驱动）。"
                                       Margin="0,8,0,0" />

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="版本" Margin="0,28,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="AboutVersionText"
                                           Style="{StaticResource RowDescStyle}"
                                           Text="1.0.0"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="检查更新"
                                        Margin="16,0,0,0"
                                        Click="CheckUpdateButton_Click" />
                                <TextBlock x:Name="AboutUpdateStatus"
                                           FontSize="12"
                                           Foreground="#5A5F68"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="项目主页" Margin="0,28,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock x:Name="AboutRepoText"
                                           Style="{StaticResource RowDescStyle}"
                                           Text="https://github.com/FatFishNet/forza-fatfish-hud"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="复制地址"
                                        Click="AboutGithubCopy_Click" />
                                <TextBlock x:Name="AboutCopyHint"
                                           Text="✓ 复制成功"
                                           FontSize="12"
                                           Foreground="{StaticResource OkBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"
                                           Opacity="0" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource SectionLabelStyle}" Text="角色形象" Margin="0,28,0,0" />
                            <Border Margin="0,12,0,0"
                                    Width="160"
                                    Height="200"
                                    HorizontalAlignment="Left"
                                    CornerRadius="8"
                                    Background="#F5F6F8">
                                <Image x:Name="AboutImage" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Style="{StaticResource RowDescStyle}"
                                       Text="角色形象原作者：B站@ZipZipPipe；经原作者同意后进行二次创作，仅用于本项目 icon。"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
