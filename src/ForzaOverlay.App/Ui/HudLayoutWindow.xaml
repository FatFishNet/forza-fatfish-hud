<Window x:Class="ForzaOverlay.App.Ui.HudLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HUD 布局编辑器"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FF0E0E0E"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1A1A1A" Padding="28,14">
            <StackPanel>
                <TextBlock Text="拖动模块调整位置，拖右下角方块调整大小；按 Enter 保存并关闭，按 Esc 取消"
                           Foreground="#FFFFD24D"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="MonitorInfoText"
                           Text="正在定位显示器…"
                           Foreground="#FF9AA0A6"
                           FontSize="12"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Grid x:Name="StageHost" Grid.Row="1" Background="#FF0E0E0E">
            <Border x:Name="Stage"
                    Background="#FF161616"
                    BorderBrush="#FF3A3A3A"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Canvas x:Name="StageCanvas"
                        Background="#FF2A2A2A"
                        ClipToBounds="True" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="28,14,28,18">
            <Button Width="120"
                    Height="38"
                    Margin="0,0,12,0"
                    Content="取消 (Esc)"
                    Background="#FFFFFFFF"
                    Foreground="#333333"
                    BorderBrush="#FFCCCCCC"
                    Click="Cancel_Click" />
            <Button Width="120"
                    Height="38"
                    Content="保存 (Enter)"
                    Background="#FF1A73E8"
                    Foreground="#FFFFFFFF"
                    BorderBrush="#FF1A73E8"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
