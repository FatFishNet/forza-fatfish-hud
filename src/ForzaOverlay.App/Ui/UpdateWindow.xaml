<Window x:Class="ForzaOverlay.App.Ui.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="检查更新"
        Width="440"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="VersionText"
                   Grid.Row="0"
                   Text="当前版本"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="#141518" />

        <TextBox x:Name="NotesBox"
                 Grid.Row="1"
                 Margin="0,14,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 BorderBrush="#D9DEE5"
                 Background="White"
                 Padding="8" />

        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="6"
                     Margin="0,14,0,0"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed" />

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,28,0,0"
                   Text=""
                   Foreground="#5A5F68" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="InstallButton"
                    Content="立即更新"
                    Padding="18,8"
                    Margin="0,0,12,0"
                    Click="InstallButton_Click" />
            <Button x:Name="LaterButton"
                    Content="稍后"
                    Padding="18,8"
                    Click="LaterButton_Click" />
        </StackPanel>
    </Grid>
</Window>
